<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/bg_black" android:orientation="vertical" android:padding="16dp">

        <TextView style="@style/Headline.Big" android:textSize="24sp" android:text="Daily Challenge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <LinearLayout style="@style/Card.Rounded" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/tvChallengeDesc" android:textColor="@color/text_primary"
                android:textSize="18sp" android:textStyle="bold" android:text="Loading..."
                android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <EditText android:id="@+id/etResult" style="@style/Input.Dark"
                android:hint="Your result (number)" android:inputType="number"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button android:id="@+id/btnSubmit" style="@style/Btn.Primary" android:text="Submit Result"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <TextView style="@style/Label.Caps" android:text="Leaderboard" android:layout_marginTop="20dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLeaderboard"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="8dp" android:paddingBottom="72dp" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/ring_streak"
        app:itemTextColor="@color/text_primary"
        android:background="@color/card_dark" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>