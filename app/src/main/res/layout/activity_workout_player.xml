<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_black" android:orientation="vertical"
    android:gravity="center" android:padding="24dp">

    <TextView android:id="@+id/tvWorkoutName" style="@style/Headline.Big" android:textSize="24sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <TextView android:id="@+id/tvTimer" style="@style/Headline.Big" android:textSize="56sp"
        android:textColor="@color/ring_streak"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <TextView style="@style/Label.Caps" android:text="@string/lbl_difficulty"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <RadioGroup android:id="@+id/rgDifficulty" android:orientation="horizontal"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:layout_marginBottom="24dp">
        <RadioButton android:id="@+id/rbEasy" android:text="@string/diff_easy" android:textColor="@color/text_primary"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/rbMedium" android:text="@string/diff_medium" android:textColor="@color/text_primary"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"
            android:layout_marginStart="12dp" />
        <RadioButton android:id="@+id/rbHard" android:text="@string/diff_hard" android:textColor="@color/text_primary"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />
    </RadioGroup>

    <Button android:id="@+id/btnFinish" style="@style/Btn.Primary" android:text="@string/btn_finish"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView android:id="@+id/tvResultMessage" android:textColor="@color/text_secondary"
        android:textSize="14sp" android:layout_marginTop="20dp" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>