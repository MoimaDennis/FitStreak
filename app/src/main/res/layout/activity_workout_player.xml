<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_black" android:orientation="vertical"
    android:gravity="center" android:padding="24dp">

    <TextView android:id="@+id/tvWorkoutName" style="@style/Headline.Big" android:textSize="24sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <TextView android:id="@+id/tvTimer" style="@style/Headline.Big" android:textSize="56sp"
        android:textColor="@color/ring_streak"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="32dp" />

    <Button android:id="@+id/btnFinish" style="@style/Btn.Primary" android:text="Finish Workout"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView android:id="@+id/tvResultMessage" android:textColor="@color/text_secondary"
        android:textSize="14sp" android:layout_marginTop="20dp" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>