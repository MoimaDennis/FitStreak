<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card_rounded"
    android:padding="16dp" android:layout_marginBottom="12dp">

    <TextView android:id="@+id/tvHistName" android:textColor="@color/text_primary"
        android:textSize="18sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <TextView android:id="@+id/tvHistDetails" android:textColor="@color/ring_xp"
        android:textSize="13sp" android:layout_marginTop="4dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>