<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/bg_card_rounded"
    android:padding="12dp" android:layout_marginBottom="8dp">

    <TextView android:id="@+id/tvUsername" android:textColor="@color/text_primary"
        android:textSize="16sp" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" />

    <TextView android:id="@+id/tvResult" android:textColor="@color/ring_challenge"
        android:textSize="16sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>