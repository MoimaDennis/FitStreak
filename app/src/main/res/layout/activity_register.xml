<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_black" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">

        <TextView android:text="@string/title_register" style="@style/Headline.Big"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="@color/ring_streak" android:layout_marginBottom="32dp" />

        <LinearLayout style="@style/Card.Rounded" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <EditText android:id="@+id/etUsername" style="@style/Input.Dark"
                android:hint="@string/hint_username" android:inputType="text"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

            <EditText android:id="@+id/etEmail" style="@style/Input.Dark"
                android:hint="@string/hint_email" android:inputType="textEmailAddress"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <EditText android:id="@+id/etPassword" style="@style/Input.Dark"
                android:hint="@string/hint_password" android:inputType="textPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button android:id="@+id/btnRegister" style="@style/Btn.Primary" android:text="@string/btn_register"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>