<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_black" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">

        <TextView android:text="@string/app_name" style="@style/Headline.Big"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/ring_streak" android:layout_marginBottom="32dp" />

        <LinearLayout style="@style/Card.Rounded" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <EditText android:id="@+id/etEmail" style="@style/Input.Dark"
                android:hint="@string/hint_email" android:inputType="textEmailAddress"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

            <EditText android:id="@+id/etPassword" style="@style/Input.Dark"
                android:hint="@string/hint_password" android:inputType="textPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button android:id="@+id/btnLogin" style="@style/Btn.Primary" android:text="@string/btn_login"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView android:text="@string/lbl_or" android:textColor="@color/text_secondary"
                android:layout_gravity="center" android:layout_marginTop="12dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <Button android:id="@+id/btnGoogle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="@string/btn_google" android:textColor="@color/text_primary"
                app:strokeColor="@color/text_secondary" app:cornerRadius="14dp"
                android:minHeight="48dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView android:id="@+id/tvRegister" android:text="@string/tv_register"
                android:textColor="@color/text_secondary" android:layout_gravity="center"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="center"
                android:layout_marginTop="16dp" android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>